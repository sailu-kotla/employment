# GEMINI_API_KEY: Optional for Gemini AI API calls. If not provided, smart rule-based assistant fallback is automatically used.
GEMINI_API_KEY=""

# MONGODB_URI: MongoDB connection string (e.g., mongodb+srv://<user>:<password>@cluster0.mongodb.net/nearwork?retryWrites=true&w=majority)
# If not provided or unavailable, NearWork automatically uses high-fidelity in-memory persistence seeded with sample data so the MVP is always 100% demo-ready.
MONGODB_URI=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
